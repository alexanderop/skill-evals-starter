# Required only for live evaluations. Authenticate the selected CLI first.
# Supported agents are claude, codex, and copilot. Claude is the default.
SKILL_EVAL_AGENT=claude
SKILL_EVAL_MODEL=claude-sonnet-5

# Codex example
# SKILL_EVAL_AGENT=codex
# SKILL_EVAL_MODEL=gpt-6-sol

# GitHub Copilot CLI example
# SKILL_EVAL_AGENT=copilot
# SKILL_EVAL_MODEL=gpt-5.4
